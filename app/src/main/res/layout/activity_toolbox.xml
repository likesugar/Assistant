                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="点击器" android:textSize="15sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                    </LinearLayout>
                </LinearLayout>



                <LinearLayout android:tag="card" android:id="@+id/cardMetronome"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_md3" android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="28dp" android:layout_height="28dp"
