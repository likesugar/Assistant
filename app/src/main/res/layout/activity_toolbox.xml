                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="28dp" android:layout_height="28dp"
                            android:background="@drawable/bg_btn_md3"
                            android:text="💊" android:textSize="15sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="用药提醒" android:textSize="15sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/medStatus"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:tag="sub"
                        android:text="🌱 还没有计划，点进去添加" android:textSize="13sp"
                        android:textColor="#8A94A6"/>
                </LinearLayout>

                <LinearLayout android:tag="card" android:id="@+id/cardShortcut"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_md3" android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView
                            android:layout_width="28dp" android:layout_height="28dp"
                            android:background="@drawable/bg_btn_md3"
                            android:text="⚡" android:textSize="15sp" android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:layout_marginLeft="12dp"
                            android:text="创建快捷键" android:textSize="15sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:tag="card" android:id="@+id/cardTapper"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
