                </LinearLayout>

                <LinearLayout android:tag="card" android:id="@+id/cardEnt"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_md3" android:orientation="vertical"
