                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:tag="card" android:id="@+id/cardWeb2Apk"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
