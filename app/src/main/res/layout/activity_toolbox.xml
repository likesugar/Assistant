                            android:text="日历" android:textSize="15sp"
                            android:textStyle="bold" android:tag="title" android:textColor="@color/textMain"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:tag="card" android:id="@+id/cardMed"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_md3" android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
