<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="20dp">
        <TextView android:id="@+id/btnBack"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="‹" android:textSize="26sp" android:paddingRight="18dp"/>
        <TextView android:id="@+id/tvTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="设置" android:textSize="22sp" android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingBottom="40dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="平台账号" android:textSize="15sp" android:id="@+id/label1"
                android:paddingTop="8dp" android:paddingBottom="14dp"/>

            <LinearLayout android:id="@+id/card1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_md3"
                android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="8dp" android:paddingBottom="20dp">

                <ScrollView android:id="@+id/platScroll"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:scrollbars="vertical" android:fadeScrollbars="false" android:scrollbarSize="3dp"
                    android:overScrollMode="never">
                <LinearLayout android:id="@+id/platList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
                </ScrollView>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="登录后使用账号可访问的画质与资源。会员、地区和平台验证限制仍以网站为准。"
                    android:textSize="13sp" android:id="@+id/desc1"
                    android:paddingTop="16dp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="登录信息只保存在本机，不会读取或保存密码；登录过期请回到这里重新登录。"
                    android:textSize="13sp" android:id="@+id/desc2"
                    android:paddingTop="8dp"/>
                <TextView android:id="@+id/btnClearAll"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="清除全部网页登录" android:textSize="15sp" android:paddingTop="16dp"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="配置文件上传与下载" android:textSize="15sp" android:id="@+id/labelGh"
                android:paddingTop="26dp" android:paddingBottom="14dp"/>

            <LinearLayout android:id="@+id/cardGh"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_md3"
                android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="8dp" android:paddingBottom="20dp">

                <LinearLayout android:id="@+id/ghList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="胶囊" android:textSize="15sp" android:id="@+id/labelCap"
                android:paddingTop="26dp" android:paddingBottom="14dp"/>

            <LinearLayout android:id="@+id/cardCapsule"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="隐藏排盘胶囊" android:textColor="@color/textMain" android:textSize="15sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="隐藏后底部导航不显示排盘入口" android:textSize="13sp" android:textColor="#8A94A6"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swHidePan" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="隐藏首页胶囊" android:textColor="@color/textMain" android:textSize="15sp"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swHideHome" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="隐藏媒体胶囊" android:textColor="@color/textMain" android:textSize="15sp"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swHideMedia" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="隐藏播放器胶囊" android:textColor="@color/textMain" android:textSize="15sp"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swHidePlayer" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView android:id="@+id/btnCapApply" android:layout_width="match_parent" android:layout_height="44dp"
                    android:gravity="center" android:text="确认生效" android:textColor="#FFFFFF"
                    android:textStyle="bold" android:textSize="15sp"
                    android:background="@drawable/bg_btn_blue" android:layout_marginTop="16dp"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="链接与提醒" android:textSize="15sp" android:id="@+id/label2"
                android:paddingTop="26dp" android:paddingBottom="14dp"/>

            <LinearLayout android:id="@+id/card2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="自动检测剪贴板" android:textSize="18sp" android:textStyle="bold" android:id="@+id/t4"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="打开应用或回到前台时，识别视频并提示下载。"
                            android:textSize="14sp" android:id="@+id/desc3" android:paddingTop="6dp"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swClipboard" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/card3"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp"
                android:layout_marginTop="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="在其他应用中添加下载" android:textSize="18sp" android:textStyle="bold" android:id="@+id/t5"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="系统不允许后台读取剪贴板。在视频应用中选择「分享 → 更多 → 资源嗅探」，确认后即可下载。"
                    android:textSize="14sp" android:id="@+id/desc5" android:paddingTop="6dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardOled"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp"
                android:layout_marginTop="18dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="OLED 纯黑模式" android:textSize="18sp" android:textStyle="bold" android:id="@+id/tOled"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="深色下纯黑背景，省电护眼" android:textSize="14sp" android:id="@+id/descOled" android:paddingTop="6dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="开" android:textSize="16sp" android:textStyle="bold" android:id="@+id/tvOled"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardDark"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp"
                android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="明暗模式" android:textSize="18sp" android:textStyle="bold" android:id="@+id/tDark"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="切换深色/浅色主题，全页跟随" android:textSize="14sp" android:id="@+id/descDark" android:paddingTop="6dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="关" android:textSize="16sp" android:textStyle="bold" android:id="@+id/tvDark"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardLan"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp"
                android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="局域网共享" android:textSize="18sp" android:textStyle="bold" android:id="@+id/tLan"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="电脑浏览器访问手机文件与下载" android:textSize="14sp" android:id="@+id/descLan" android:paddingTop="6dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🗄️" android:textSize="16sp" android:id="@+id/tvLan"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardNotify"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp"
                android:layout_marginTop="18dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="下载通知" android:textSize="18sp" android:textStyle="bold" android:id="@+id/t6"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="管理进度与完成提醒" android:textSize="14sp" android:id="@+id/desc6" android:paddingTop="6dp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="→" android:textSize="20sp" android:id="@+id/arrow"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardAbout2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_md3"
                android:padding="20dp"
                android:layout_marginTop="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="关于" android:textSize="18sp" android:textStyle="bold" android:id="@+id/tvAboutTitle2"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="查看每个卡片的用途说明"
                    android:textSize="14sp" android:id="@+id/tvAboutText2" android:paddingTop="8dp"/>
            </LinearLayout>

            
        </LinearLayout>
    </ScrollView>
</LinearLayout>
