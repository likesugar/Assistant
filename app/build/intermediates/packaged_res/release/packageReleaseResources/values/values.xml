<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr format="reference" name="codeEditorStyle"/>
    <color name="bg">#EEF4FF</color>
    <color name="black">#000000</color>
    <color name="blue1">#4D9AFF</color>
    <color name="blue2">#1677FF</color>
    <color name="defaultSymbolInputBackgroundColor">@android:color/background_light</color>
    <color name="defaultSymbolInputTextColor">@android:color/black</color>
    <color name="divider">#F0F2F5</color>
    <color name="dkplayer_background_color">#4D000000</color>
    <color name="dkplayer_theme_color">#FFFFFF</color>
    <color name="dkplayer_theme_color_translucent">#99FFFFFF</color>
    <color name="green2">#0E9F6E</color>
    <color name="textActionNameColor">@android:color/tertiary_text_light</color>
    <color name="textMain">#1F2329</color>
    <color name="textSub">#8A94A6</color>
    <color name="white">#FFFFFF</color>
    <dimen name="dkplayer_controller_height">46dp</dimen>
    <dimen name="dkplayer_controller_icon_padding">12dp</dimen>
    <dimen name="dkplayer_controller_seekbar_max_size">1dp</dimen>
    <dimen name="dkplayer_controller_seekbar_size_n">14dp</dimen>
    <dimen name="dkplayer_controller_seekbar_size_s">14dp</dimen>
    <dimen name="dkplayer_controller_text_size">16sp</dimen>
    <dimen name="dkplayer_controller_time_text_size">14sp</dimen>
    <dimen name="dkplayer_default_spacing">10dp</dimen>
    <dimen name="dkplayer_play_btn_size">50dp</dimen>
    <item name="tag_hearted" type="id"/>
    <string name="app_name">资源助手</string>
    <string name="app_name_english" translatable="false">DBDown</string>
    <string name="dkplayer_continue_play">继续播放</string>
    <string name="dkplayer_error_message">出了点小问题，请稍后重试</string>
    <string name="dkplayer_lock_tip">请先解锁屏幕！</string>
    <string name="dkplayer_locked">已锁定</string>
    <string name="dkplayer_replay">重新播放</string>
    <string name="dkplayer_retry"> 重    试 </string>
    <string name="dkplayer_unlocked">已解锁</string>
    <string name="dkplayer_wifi_tip">您正在使用移动网络，继续播放将消耗流量</string>
    <string name="gkd_a11y_desc">GKD 去广告: 根据订阅规则在启用应用内自动点击跳过/关闭按钮</string>
    <string name="sora_editor_clip_text_length_too_large">Text is too large to copy</string>
    <string name="sora_editor_diagnostics_more_actions">More Actions...</string>
    <string name="sora_editor_editor_formatting">Formatting your code…</string>
    <string name="sora_editor_editor_search_busy">Editor is still preparing…</string>
    <string name="sora_editor_editor_search_replacing">Replacing texts…</string>
    <string name="sora_editor_last">Last</string>
    <string name="sora_editor_long_select">Long Select</string>
    <string name="sora_editor_more">More</string>
    <string name="sora_editor_next">Next</string>
    <string name="sora_editor_replace">Replace</string>
    <string name="sora_editor_replaceAll">Replace All</string>
    <string name="sora_editor_replacement">Replacement</string>
    <string name="sora_editor_text_to_search">Text to search</string>
    <string name="tapper_desc">自动点击器: 无障碍手势模拟点击, 无需 root</string>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/blue2</item>
        <item name="colorPrimary">@color/blue2</item>
        <item name="colorSecondary">@color/blue2</item>
        <item name="android:colorControlHighlight">#22315CDE</item>
    </style>
    <style name="diagnostic_popup_animation">
        <item name="android:windowEnterAnimation">@anim/anim_diagnostic_tooltip_window_enter</item>
        <item name="android:windowExitAnimation">@anim/anim_diagnostic_tooltip_window_exit</item>
    </style>
    <style name="text_action_popup_animation">
        <item name="android:windowEnterAnimation">@anim/anim_text_action_popup_enter</item>
        <item name="android:windowExitAnimation">@anim/anim_text_action_popup_exit</item>
    </style>
    <declare-styleable name="BaseVideoView">
        <attr format="boolean" name="looping"/>
        <attr format="boolean" name="enableAudioFocus"/>
        <attr format="dimension" name="screenScaleType">
            <enum name="type_default" value="0"/>
            <enum name="type_16_9" value="1"/>
            <enum name="type_4_3" value="2"/>
            <enum name="type_match_parent" value="3"/>
            <enum name="type_original" value="4"/>
            <enum name="type_center_crop" value="5"/>
        </attr>
        <attr format="color" name="playerBackgroundColor"/>
    </declare-styleable>
    <declare-styleable name="CodeEditor">
        <attr format="reference" name="scrollbarTrackHorizontal"/>
        <attr format="reference" name="scrollbarThumbHorizontal"/>
        <attr format="reference" name="scrollbarTrackVertical"/>
        <attr format="reference" name="scrollbarThumbVertical"/>

        <attr name="lnPanelPositionMode">
            <enum name="fixed" value="0"/>
            <enum name="follow" value="1"/>
        </attr>
        <attr name="lnPanelPosition">
            <flag name="left" value="1"/>
            <flag name="top" value="2"/>
            <flag name="right" value="4"/>
            <flag name="bottom" value="8"/>
            <flag name="center" value="15"/>
        </attr>

        <attr format="string" name="text"/>
        <attr format="dimension" name="textSize"/>
        <attr format="dimension" name="dividerWidth"/>
        <attr format="dimension" name="dividerMargin"/>
        <attr format="boolean" name="lineNumberVisible"/>
        <attr format="boolean" name="autoCompleteEnabled"/>
        <attr format="boolean" name="symbolCompletionEnabled"/>
        <attr format="integer" name="cursorBlinkPeriod"/>
        <attr format="boolean" name="verticalScrollbarEnabled"/>
        <attr format="boolean" name="horizontalScrollbarEnabled"/>
        <attr format="boolean" name="pinLineNumber"/>
        <attr name="wordwrapMode">
            <enum name="off" value="0"/>
            <!-- Without anti-word-breaking -->
            <enum name="basic" value="1"/>
            <!-- With anti-word-breaking -->
            <enum name="standard" value="2"/>
        </attr>
        <attr format="boolean" name="highlightCurrentLine"/>
        <attr format="boolean" name="highlightCurrentBlock"/>
        <attr format="boolean" name="highlightBracketPair"/>
        <attr format="boolean" name="ligatures"/>
        <attr format="boolean" name="renderFunctionChars"/>
        <attr format="boolean" name="scalable"/>
        <attr format="integer" name="tabWidth"/>
    </declare-styleable>
</resources>